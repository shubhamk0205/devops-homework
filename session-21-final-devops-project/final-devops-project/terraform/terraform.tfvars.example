public_subnet_cidrs  = ["10.21.1.0/24", "10.21.2.0/24"]
private_subnet_cidrs = ["10.21.11.0/24", "10.21.12.0/24"]
availability_zones   = ["ap-south-1a", "ap-south-1b"]
backup_bucket_name   = "shubham-session21-helpdesk-backups"
enable_eks           = false
