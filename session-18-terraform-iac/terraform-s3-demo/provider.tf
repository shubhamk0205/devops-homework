terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

# I don't have an AWS account, so this provider points to LocalStack
# (a fake AWS running in Docker on localhost:4566).
# For real AWS: remove the access_key/secret_key, the skip_* lines,
# s3_use_path_style and the endpoints block, and use real credentials.
provider "aws" {
  region     = var.aws_region
  access_key = "test"
  secret_key = "test"

  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true
  s3_use_path_style           = true

  endpoints {
    s3  = "http://localhost:4566"
    sts = "http://localhost:4566"
  }
}
